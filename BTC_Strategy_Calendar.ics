BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//BTC 3x Cycle Strategy//Playbook//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:BTC 3x 周期策略
X-WR-TIMEZONE:Asia/Shanghai
X-WR-CALDESC:核心策略关键日期 — 见底入场 / 减半锚 / 逃顶三批
BEGIN:VEVENT
UID:btc-strategy-2026-08-01@playbook
DTSTAMP:20260531T000000Z
DTSTART;VALUE=DATE:20260801
DTEND;VALUE=DATE:20260802
SUMMARY:🟡 进入"见底观察期" — 准备 $7000 + OKX 账户
DESCRIPTION:开始盯盘 BTC 是否见底。\n准备工作:\n- OKX 账户充值 $7000\n- 杠杆滑块预设 3x\n- 等价格从低点反弹 5-10% 再入场 (别接飞刀)
CATEGORIES:BTC,准备
BEGIN:VALARM
TRIGGER:-P30D
ACTION:DISPLAY
DESCRIPTION:1 个月后进入 BTC 见底观察期
END:VALARM
BEGIN:VALARM
TRIGGER:-P7D
ACTION:DISPLAY
DESCRIPTION:1 周后进入 BTC 见底观察期
END:VALARM
BEGIN:VALARM
TRIGGER:PT9H
ACTION:DISPLAY
DESCRIPTION:今天起开始盯 BTC 见底信号
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:btc-strategy-2026-09-30@playbook
DTSTAMP:20260531T000000Z
DTSTART;VALUE=DATE:20260930
DTEND;VALUE=DATE:20261001
SUMMARY:🟢 见底窗口末 — 若已反弹 5-10% 则 3x 满仓做多
DESCRIPTION:触发条件:\n- 价格从最近低点反弹 5-10% 确认\n- OKX 杠杆 3x\n- 全部 $7000 保证金开多 (可分 2-3 次)\n\n红线: 只在底部区域开 3x. 远高于底则降杠杆.
CATEGORIES:BTC,入场
BEGIN:VALARM
TRIGGER:-P14D
ACTION:DISPLAY
DESCRIPTION:见底窗口将结束 — 2 周内决定是否入场
END:VALARM
BEGIN:VALARM
TRIGGER:PT9H
ACTION:DISPLAY
DESCRIPTION:决策日: 若已见底反弹则 3x 满仓
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:btc-strategy-2028-04-15@playbook
DTSTAMP:20260531T000000Z
DTSTART;VALUE=DATE:20280415
DTEND;VALUE=DATE:20280416
SUMMARY:⚓ BTC 第 4 次减半 — 逃顶倒计时启动
DESCRIPTION:不操作. 仅作为锚点:\n顶 = 减半 + 17.3~18.0 月\n→ 逃顶窗口 2029-08-15 ~ 2029-09-15
CATEGORIES:BTC,锚点
BEGIN:VALARM
TRIGGER:-P7D
ACTION:DISPLAY
DESCRIPTION:1 周后 BTC 减半 — 逃顶倒计时开始 (~17 月后)
END:VALARM
BEGIN:VALARM
TRIGGER:PT9H
ACTION:DISPLAY
DESCRIPTION:BTC 减半日. 距逃顶约 17 月.
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:btc-strategy-2029-06-01@playbook
DTSTAMP:20260531T000000Z
DTSTART;VALUE=DATE:20290601
DTEND;VALUE=DATE:20290602
SUMMARY:⛔ 停止吃回撤 sleeve (dip-buy 截止)
DESCRIPTION:减半+14 月. 之后:\n- 停止所有 dip-buy 操作\n- 因为接下来的"回撤"可能是熊市开始, 回不来\n- 核心仓继续死扛
CATEGORIES:BTC,可选
BEGIN:VALARM
TRIGGER:-P14D
ACTION:DISPLAY
DESCRIPTION:2 周后停止吃回撤
END:VALARM
BEGIN:VALARM
TRIGGER:PT9H
ACTION:DISPLAY
DESCRIPTION:今天起停止 dip-buy sleeve
END:VALARM
END:VEVENT
